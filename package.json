{
  "name": "tasks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "generate-api": "npm run fetch-swagger && swagger-typescript-api generate -p ./swagger.json -o ./src/api -n Api --axios",
    "fetch-swagger": "curl -o swagger.json http://localhost:5000/swagger/v1/swagger.json",
    "format": "oxfmt src/"
  },
  "dependencies": {
    "axios": "^1.15.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.31",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.1",
    "naive-ui": "^2.44.1",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.42.0",
    "swagger-typescript-api": "^13.6.10",
    "typescript": "~6.0.0",
    "vite": "^8.0.3",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
